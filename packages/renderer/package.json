{
  "name": "@wirecannon/renderer",
  "version": "0.1.2",
  "description": "Reference HTML/SVG renderer for Wirecannon .wcf files",
  "repository": { "type": "git", "url": "https://github.com/adm351/wirecannon" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "package.json"
  ],
  "bin": {
    "wirecannon-render": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "node ../../scripts/package-docs.js copy .",
    "postpack": "node ../../scripts/package-docs.js clean ."
  },
  "dependencies": {
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
